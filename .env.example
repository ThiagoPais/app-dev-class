# GitHub Codespaces Secrets / Environment Variables
# In GitHub Codespaces, add these under Repository Secrets or Codespaces Secrets

# Firebase Client Configuration
FIREBASE_API_KEY=[api-key]
FIREBASE_AUTH_DOMAIN=[auth-domain]
FIREBASE_PROJECT_ID=[project-id]
FIREBASE_STORAGE_BUCKET=[storage-bucket]
FIREBASE_MESSAGING_SENDER_ID=[messaging-sender-id]
FIREBASE_APP_ID=[app-id]
FIRESTORE_DB_NAME=[firestore-db-name]

# Google Maps (Android map and the web/WebView map in the region screen; iOS uses Apple Maps).
# Web also needs the Maps JavaScript API enabled for this key (restrict it by HTTP referrer).
GOOGLE_MAPS_API_KEY=[google-maps-api-key]
