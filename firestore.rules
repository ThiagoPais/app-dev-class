rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function topicAvailable(topicId) {
      return !get(/databases/$(database)/documents/forum_topics/$(topicId)).data.is_deleted;
    }

    match /cpf_registry/{cpf} {
      // Signup checks uniqueness after Firebase Auth creates the account.
      // CPF login verifies the password in a callable; it never exposes profiles.
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isAuthenticated()
        && cpf.matches('^[0-9]{11}$')
        && request.resource.data.userId == request.auth.uid
        && !exists(/databases/$(database)/documents/cpf_registry/$(cpf));
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // ---------- Forum ----------
    // Without Cloud Functions the app writes votes, replies and counters itself.
    // Each counter may only change in the same transaction as the vote or reply
    // that justifies it, so clients cannot forge numbers.

    function topicPath(topicId) {
      return /databases/$(database)/documents/forum_topics/$(topicId);
    }

    function messagePath(topicId, messageId) {
      return /databases/$(database)/documents/forum_topics/$(topicId)/messages/$(messageId);
    }

    function topicVotePath(topicId, userId) {
      return /databases/$(database)/documents/forum_topics/$(topicId)/votes/$(userId);
    }

    function messageVotePath(topicId, messageId, userId) {
      return /databases/$(database)/documents/forum_topics/$(topicId)/messages/$(messageId)/votes/$(userId);
    }

    function voteDelta(after, before, type) {
      return (after == type ? 1 : 0) - (before == type ? 1 : 0);
    }

    // Item (topic or reply) counters changed exactly as the requester's vote did.
    function countersFollowVote(votePath) {
      let before = exists(votePath) ? get(votePath).data.vote_type : null;
      let after = existsAfter(votePath) ? getAfter(votePath).data.vote_type : null;
      let up = voteDelta(after, before, 'up');
      let down = voteDelta(after, before, 'down');
      return before != after
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['upvotes_count', 'downvotes_count', 'net_votes'])
        && request.resource.data.upvotes_count == resource.data.upvotes_count + up
        && request.resource.data.downvotes_count == resource.data.downvotes_count + down
        && request.resource.data.net_votes == resource.data.net_votes + up - down;
    }

    // Vote document written together with the matching counter change on its item.
    function voteFollowedByCounters(itemPath) {
      let before = resource == null ? null : resource.data.vote_type;
      let after = request.method == 'delete' ? null : request.resource.data.vote_type;
      let up = voteDelta(after, before, 'up');
      let down = voteDelta(after, before, 'down');
      return before != after
        && (request.method == 'delete'
          || (request.resource.data.keys().hasOnly(['vote_type', 'created_at'])
            && after in ['up', 'down']
            && request.resource.data.created_at == request.time))
        && !get(itemPath).data.is_deleted
        && getAfter(itemPath).data.upvotes_count == get(itemPath).data.upvotes_count + up
        && getAfter(itemPath).data.downvotes_count == get(itemPath).data.downvotes_count + down
        && getAfter(itemPath).data.net_votes == get(itemPath).data.net_votes + up - down;
    }

    // Topic counter bump that accompanies a reply created in the same transaction.
    function replyAdded(topicId) {
      let replyId = request.resource.data.get('last_reply_id', '');
      let replyPath = messagePath(topicId, replyId);
      return !resource.data.is_locked
        && replyId != ''
        && !exists(replyPath)
        && existsAfter(replyPath)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['replies_count', 'last_reply_at', 'last_reply_id'])
        && request.resource.data.replies_count == resource.data.replies_count + 1
        && request.resource.data.last_reply_at == request.time;
    }

    // Topic counter decrement that accompanies the author removing their reply.
    function replyRemoved(topicId) {
      let replyId = request.resource.data.get('last_removed_reply_id', '');
      let replyPath = messagePath(topicId, replyId);
      return replyId != ''
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['replies_count', 'last_removed_reply_id'])
        && request.resource.data.replies_count == resource.data.replies_count - 1
        && get(replyPath).data.author_id == request.auth.uid
        && get(replyPath).data.is_deleted == false
        && getAfter(replyPath).data.is_deleted == true;
    }

    match /forum_topics/{topicId} {
      allow read: if isAuthenticated()
        && (resource == null || !resource.data.is_deleted || isOwner(resource.data.author_id));

      allow create: if isAuthenticated()
        && request.resource.data.author_id == request.auth.uid
        && request.resource.data.upvotes_count == 0
        && request.resource.data.downvotes_count == 0
        && request.resource.data.net_votes == 0
        && request.resource.data.replies_count == 0
        && request.resource.data.is_pinned == false
        && request.resource.data.is_locked == false
        && request.resource.data.is_deleted == false;

      allow update: if (isOwner(resource.data.author_id)
          && !resource.data.is_deleted
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['title', 'content', 'updated_at', 'is_deleted'])
          && request.resource.data.updated_at == request.time
          && request.resource.data.is_deleted is bool)
        || (isAuthenticated() && !resource.data.is_deleted && (
          countersFollowVote(topicVotePath(topicId, request.auth.uid))
          || replyAdded(topicId)
          || replyRemoved(topicId)));
      allow delete: if false;

      match /votes/{userId} {
        allow read: if isOwner(userId) && topicAvailable(topicId);
        allow create, update, delete: if isOwner(userId)
          && topicAvailable(topicId)
          && voteFollowedByCounters(topicPath(topicId));
      }

      match /messages/{messageId} {
        // Authors can still read their removed reply so a retried delete is a no-op.
        allow read: if isAuthenticated() && topicAvailable(topicId)
          && (resource == null || !resource.data.is_deleted || isOwner(resource.data.author_id));

        allow create: if isOwner(request.resource.data.author_id)
          && topicAvailable(topicId)
          && !get(topicPath(topicId)).data.is_locked
          && request.resource.data.keys().hasOnly(['topic_id', 'author_id', 'author_snapshot',
            'content', 'upvotes_count', 'downvotes_count', 'net_votes', 'is_deleted',
            'created_at', 'updated_at'])
          && request.resource.data.topic_id == topicId
          && request.resource.data.author_snapshot.full_name
            == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.fullName
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 2000
          && request.resource.data.upvotes_count == 0
          && request.resource.data.downvotes_count == 0
          && request.resource.data.net_votes == 0
          && request.resource.data.is_deleted == false
          && request.resource.data.created_at == request.time
          && request.resource.data.updated_at == request.time
          && getAfter(topicPath(topicId)).data.replies_count
            == get(topicPath(topicId)).data.replies_count + 1
          && getAfter(topicPath(topicId)).data.last_reply_id == messageId;

        allow update: if topicAvailable(topicId) && !resource.data.is_deleted && (
          (isOwner(resource.data.author_id)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'updated_at'])
            && request.resource.data.content is string
            && request.resource.data.content.size() > 0
            && request.resource.data.content.size() <= 2000
            && request.resource.data.updated_at == request.time)
          || (isOwner(resource.data.author_id)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_deleted', 'updated_at'])
            && request.resource.data.is_deleted == true
            && request.resource.data.updated_at == request.time
            && getAfter(topicPath(topicId)).data.replies_count
              == get(topicPath(topicId)).data.replies_count - 1
            && getAfter(topicPath(topicId)).data.last_removed_reply_id == messageId)
          || (isAuthenticated()
            && countersFollowVote(messageVotePath(topicId, messageId, request.auth.uid))));
        allow delete: if false;

        match /votes/{userId} {
          allow read: if isOwner(userId)
            && topicAvailable(topicId)
            && !get(messagePath(topicId, messageId)).data.is_deleted;
          allow create, update, delete: if isOwner(userId)
            && topicAvailable(topicId)
            && voteFollowedByCounters(messagePath(topicId, messageId));
        }
      }
    }

    // ---------- Chat ----------
    // Direct and group chats live in `chats`; messages in `chats/{id}/chat_messages`.
    // Nothing is hard-deleted by clients (soft delete only). The rules cannot check that
    // `last_message` or the unread counters match the real messages: members are trusted
    // to write them through the service layer.

    function chatPath(chatId) {
      return /databases/$(database)/documents/chats/$(chatId);
    }

    // Membership uses the chat as it was BEFORE the write, so a member who leaves can
    // still write their own `member_left` message in the same batch.
    function isChatMember(chatId) {
      return isAuthenticated()
        && request.auth.uid in get(chatPath(chatId)).data.user_ids;
    }

    function isSystemMessageBy(uid) {
      return request.resource.data.type == 'system'
        && request.resource.data.author_id == null
        && request.resource.data.system_event.actor_id == uid;
    }

    // The `group_created` message is written in the same batch as the group itself, when
    // the chat does not exist yet (so `isChatMember` has nothing to read).
    function isGroupCreatedMessage(chatId) {
      return isSystemMessageBy(request.auth.uid)
        && request.resource.data.system_event.kind == 'group_created'
        && !exists(chatPath(chatId))
        && existsAfter(chatPath(chatId))
        && getAfter(chatPath(chatId)).data.created_by == request.auth.uid;
    }

    // Admins after a member leaves: unchanged minus the leaver, except that when the leaver
    // was the only admin and members remain, exactly the oldest remaining member is promoted
    // (what the service does). A leaver cannot otherwise grant or revoke admin rights.
    function adminsAfterLeaving() {
      let remaining = resource.data.admin_ids.removeAll([request.auth.uid]);
      let members = request.resource.data.user_ids;
      return (remaining.size() > 0 && request.resource.data.admin_ids == remaining)
        || (remaining.size() == 0 && members.size() == 0 && request.resource.data.admin_ids == [])
        || (remaining.size() == 0 && members.size() > 0
          && request.resource.data.admin_ids == [members[0]]);
    }

    match /chats/{chatId} {
      // A missing chat is readable so the app can tell "no chat yet" from "not allowed".
      allow read: if isAuthenticated()
        && (resource == null || request.auth.uid in resource.data.user_ids);

      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.user_ids && (
          // Direct chat: canonical sorted ID, immutable pair
          (request.resource.data.type == 'direct'
            && request.resource.data.user_ids.size() == 2
            && request.resource.data.user_ids[0] < request.resource.data.user_ids[1]
            && chatId == request.resource.data.user_ids[0] + '_' + request.resource.data.user_ids[1]
            && request.resource.data.admin_ids.size() == 0
            && request.resource.data.last_message == null)
          ||
          // Group chat: creator first and sole admin, 2-100 members
          (request.resource.data.type == 'group'
            && request.resource.data.user_ids.size() >= 2
            && request.resource.data.user_ids.size() <= 100
            && request.resource.data.user_ids[0] == request.auth.uid
            && request.resource.data.admin_ids == [request.auth.uid]
            && request.resource.data.created_by == request.auth.uid
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 1
            && request.resource.data.name.size() <= 60
            && request.resource.data.last_message == null)
        );

      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.user_ids
        && request.resource.data.type == resource.data.type
        && (
          // (a) Any member: preview and counters only
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['last_message', 'last_message_at', 'unread_counts', 'updated_at'])
          ||
          // (b) Group admin: membership, roles and group info. The admin must remain a
          // member: an admin leaving the group goes through (c) like everyone else.
          (resource.data.type == 'group'
            && request.auth.uid in resource.data.admin_ids
            && request.auth.uid in request.resource.data.user_ids
            && request.resource.data.user_ids.size() <= 100
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['user_ids', 'admin_ids', 'participants', 'unread_counts', 'name',
                'avatar_url', 'updated_at']))
          ||
          // (c) Group member leaving: may only remove themselves, touch their own
          // participant/unread entries, and (see adminsAfterLeaving) trigger succession
          (resource.data.type == 'group'
            && request.resource.data.user_ids == resource.data.user_ids.removeAll([request.auth.uid])
            && adminsAfterLeaving()
            && request.resource.data.participants.diff(resource.data.participants)
              .affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.unread_counts.diff(resource.data.unread_counts)
              .affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['user_ids', 'admin_ids', 'participants', 'unread_counts', 'updated_at']))
        );

      allow delete: if false;

      match /chat_messages/{messageId} {
        allow read: if isChatMember(chatId);

        allow create: if isAuthenticated()
          && request.resource.data.chat_id == chatId
          && request.resource.data.is_deleted == false
          && (
            (isChatMember(chatId) && (
              (request.resource.data.type == 'text'
                && request.resource.data.author_id == request.auth.uid
                && request.resource.data.message is string
                && request.resource.data.message.size() >= 1
                && request.resource.data.message.size() <= 2000)
              || isSystemMessageBy(request.auth.uid)))
            || isGroupCreatedMessage(chatId)
          );

        // Authors may only edit the body or soft-delete their own text message
        allow update: if isChatMember(chatId)
          && resource.data.type == 'text'
          && resource.data.author_id == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['message', 'updated_at', 'is_deleted']);

        allow delete: if false;
      }
    }
  }
}
